<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mensa_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ausgaben -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensa diesen Monat"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/m_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00 €"
                android:textColor="@color/pay"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/m_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mensa-Auswahl -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/m_slot0"
                style="@style/ToggleButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="TU Hardenberg" />

            <Button
                android:id="@+id/m_slot1"
                style="@style/ToggleButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Veggie 2.0" />

            <Button
                android:id="@+id/m_settings"
                style="@style/ToggleButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:contentDescription="Mensa-Einstellungen"
                android:text="⚙" />
        </LinearLayout>

        <!-- Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/m_prev"
                style="@style/ToggleButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:contentDescription="Vorheriger Tag"
                android:text="◀" />

            <TextView
                android:id="@+id/m_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/m_next"
                style="@style/ToggleButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Nächster Tag"
                android:text="▶" />

            <Button
                android:id="@+id/m_reload"
                style="@style/ToggleButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:contentDescription="Neu laden"
                android:text="⟳" />
        </LinearLayout>

        <TextView
            android:id="@+id/m_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/m_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/m_custom"
            style="@style/SmallButton"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="Eigenes Essen eintragen" />

        <Button
            android:id="@+id/m_undo"
            style="@style/SmallButton"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="Letztes Essen rückgängig" />

        <!-- Diagramm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensa pro Woche"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <de.uni.getraenke.BarChartView
                android:id="@+id/m_chart"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/m_chart_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="Gegessen (antippen zum Löschen)" />

        <LinearLayout
            android:id="@+id/m_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp" />
    </LinearLayout>
</ScrollView>
