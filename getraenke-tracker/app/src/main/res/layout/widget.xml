<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guthaben"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00 €"
                android:textColor="@color/credit"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Getrunken 0,00 € · Eingezahlt 0,00 €"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_spezi"
            style="@style/WidgetButton"
            android:background="@drawable/btn_spezi"
            android:text="Spezi\n0×" />

        <Button
            android:id="@+id/w_sterni"
            style="@style/WidgetButton"
            android:background="@drawable/btn_sterni"
            android:text="Sterni\n0×" />

        <Button
            android:id="@+id/w_mate"
            style="@style/WidgetButton"
            android:background="@drawable/btn_mate"
            android:text="Mate\n0×" />

        <Button
            android:id="@+id/w_pay"
            style="@style/WidgetButton"
            android:layout_marginEnd="0dp"
            android:background="@drawable/btn_pay"
            android:text="€\nzahlen" />
    </LinearLayout>
</LinearLayout>
